{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/relay/:path*", "destination": "/api/proxy?__agentPath=:path*" },
    { "source": "/api/agent/:path*", "destination": "/api/proxy?__agentPath=:path*" }
  ],
  "headers": [
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app-settings.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
